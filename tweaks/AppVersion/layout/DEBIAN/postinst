#!/bin/sh
# A private directory owned by mobile, mode 0700.
#
# NOT chmod 1777 on /var/jb/tmp, which 0.2.0 did: that widened permissions on a
# shared directory this package does not own, left the log world-readable, and
# allowed any process to pre-create the log as a symlink for our writes to
# follow.
set -e

LOGDIR=/var/jb/var/mobile/Library/Logs/AppVersion

mkdir -p "$LOGDIR"
chown mobile:mobile "$LOGDIR"
chmod 700 "$LOGDIR"

exit 0
